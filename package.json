{
    "private": true,
    "scripts": {
        "check-updates": "npx @badisi/check-updates -i '{,projects/!(tests)/**/}package.json'",
        "typecheck": "tsc --build --noEmit",
        "prepare": "husky || true"
    },
    "workspaces": [
        "projects/lib",
        "projects/docs",
        "projects/tests"
    ],
    "devDependencies": {
        "@angular-devkit/core": "^22.1.8",
        "@angular-devkit/schematics": "^22.1.8",
        "@angular/cli": "^22.1.8",
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.2.3",
        "@hug/eslint-config": "^28.0.0",
        "@schematics/angular": "^22.1.8",
        "@types/node": "^26.6.2",
        "@types/semver": "^7.8.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.5.1",
        "rxjs": "7.8.2",
        "tsdown": "^0.23.0",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "vitest": "^5.0.1"
    },
    "overrides": {
        "copy-webpack-plugin": {
            "serialize-javascript": "^7.0.0"
        },
        "css-minimizer-webpack-plugin": {
            "serialize-javascript": "^7.0.0"
        },
        "sockjs": {
            "uuid": "^14.0.0"
        }
    },
    "commitlint": {
        "extends": [
            "@commitlint/config-conventional"
        ]
    },
    "lint-staged": {
        "**/*.{js,json,ts,html}": [
            "eslint --fix"
        ]
    },
    "allowScripts": {
        "@hug/eslint-config": true,
        "core-js": true,
        "fsevents": true,
        "esbuild": true
    }
}
